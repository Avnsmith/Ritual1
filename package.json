{
  "name": "wowweb",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:packages && npm --prefix apps/server run build && npm --prefix apps/web run build",
    "build:packages": "npm --prefix packages/shared run build && npm --prefix packages/contracts run build && npm --prefix packages/agents run build",
    "test": "npx ts-node --compiler-options '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' tests/runner.ts all",
    "test:unit": "npx ts-node --compiler-options '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' tests/runner.ts unit",
    "test:integration": "npx ts-node --compiler-options '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' tests/runner.ts integration",
    "test:contracts": "npx ts-node --compiler-options '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' tests/runner.ts contracts",
    "test:e2e": "npx ts-node --compiler-options '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' tests/runner.ts all"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "solc": "^0.8.20"
  }
}
